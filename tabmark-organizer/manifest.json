{
  "manifest_version": 3,
  "name": "TabMark · AI 浏览器书签整理",
  "version": "1.1.2",
  "description": "将浏览器书签同步到侧栏整理，AI 智能归类命名，并写回 Chrome 原位置",
  "permissions": ["bookmarks", "storage", "sidePanel"],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 TabMark 书签整理器",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
